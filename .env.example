# ============================================================================
# Database Configuration (Supabase PostgreSQL / Remote Database)
# ============================================================================
# Option 1: Supabase Direct / Pooler Connection URL (Recommended)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Option 2: Discrete PostgreSQL Parameters (Cloud SQL / Self-hosted)
SQL_HOST=
SQL_PORT=5432
SQL_DB_NAME=postgres
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
SQL_SSL=true

# ============================================================================
# Production Server Port (Render automatically supplies PORT=10000)
# ============================================================================
PORT=3000
NODE_ENV=production

# ============================================================================
# Optional Integration Keys
# ============================================================================
# Optional Supabase Client SDK Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Maps API Key for satellite basemaps & GIS buffer visualization
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Gemini API Key for smart biosecurity assessments & executive report generation
GEMINI_API_KEY=
